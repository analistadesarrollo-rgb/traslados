{
  "name": "whatsapp-transfer-bot",
  "version": "1.0.0",
  "description": "Sistema de automatización de traslados de colocadores entre sucursales vía WhatsApp",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/index.js",
    "worker": "node src/index.js --worker",
    "web": "node src/index.js --web",
    "whatsapp": "node src/index.js --whatsapp",
    "migrate": "node src/database/migrate.js",
    "db:init": "node src/database/migrate.js",
    "test": "node --test \"tests/*.test.js\"",
    "test:parser": "node --test tests/parser.test.js tests/validation.test.js",
    "test:unit": "node --test tests/parser.test.js tests/validation.test.js tests/idempotency.test.js tests/shift.test.js tests/queue.test.js",
    "qr": "node src/whatsapp/qr.js"
  },
  "keywords": [
    "whatsapp",
    "automation",
    "transport",
    "shifts",
    "traslados",
    "puppeteer"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  }
}
