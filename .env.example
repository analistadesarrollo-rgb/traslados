# ============================================================
# WHATSAPP TRANSFER BOT - Configuración
# Copie este archivo a `.env` y complete los valores.
# NUNCA suba `.env` a Git, el archivo `.env` está en .gitignore.
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=development

# --- Sistema web externo que se automatiza ---
WEB_SYSTEM_URL=http://192.168.60.66:8090/BusinessNET-WEB/XHTML/azar/adminventa/horariopersonas.xhtml
WEB_SYSTEM_USER=
WEB_SYSTEM_PASSWORD=

# --- Base de datos (archivo SQLite local) ---
# Se usará SQLite embebido (node:sqlite) por defecto para ejecución inmediata.
# Si prefiere MySQL/MariaDB, consulte el README (sección "Base de datos").
DB_FILE=./data/transfer-bot.sqlite

# --- WhatsApp (whatsapp-web.js) ---
# Directorio donde se guarda la sesión persistente (LocalAuth).
WA_SESSION_DIR=./data/wa-session
# Directorio donde se guardan los medios descargados (opcional)
WA_MEDIA_DIR=./data/media
# Tiempo (ms) de espera para que el usuario escanee el QR antes de re-escaneo
WA_QR_TIMEOUT_MS=120000
# Solo escuchar mensajes de números autorizados (separados por coma). Vacío = todos.
ALLOWED_PHONE_NUMBERS=

# --- Navegador automatizado (Puppeteer) ---
# Ruta al ejecutable de Chrome/Chromium. Dejar vacío para usar el detectado.
CHROME_PATH=
# Modo headless del navegador de automatización del sistema web (true/false)
AUTOMATION_HEADLESS=true
# Ruta al navegador usado por WhatsApp (por defecto usa el de Puppeteer)
WA_BROWSER_PATH=

# --- Queue / Worker ---
# Número de workers que procesan traslados en paralelo (máximo 1 por documento)
WORKER_CONCURRENCY=1
# Intervalo (ms) de sondeo de la cola cuando está vacía
QUEUE_POLL_INTERVAL_MS=2000
# Tiempo máximo (ms) que un job puede permanecer en PROCESSING antes de reasignarse
JOB_LEASE_MS=300000

# --- Panel administrativo (protección simple por contraseña) ---
ADMIN_USER=admin
ADMIN_PASSWORD=

# --- Logging ---
# Nivel de log: trace, debug, info, warn, error
LOG_LEVEL=info
# Directorio donde se escriben los logs de archivo
LOG_DIR=./logs

# --- Tiempos de espera (ms) para la automatización del sistema web ---
AUTOMATION_TIMEOUT_MS=30000
